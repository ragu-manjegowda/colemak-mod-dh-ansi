#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>

&lt {
    tapping-term-ms = <220>;
    quick-tap-ms = <180>;
    require-prior-idle-ms = <150>;
};

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"
        #include "smart_mouse.dtsi"

        combos {
            compatible = "zmk,combos";

            combo_bt_clr {
                bindings = <&bt BT_CLR>;
                timeout-ms = <150>;
                key-positions = <19 48>;
                layers = <3>;
            };
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &none               &kp N1          &kp N2              &kp N3                  &kp N4                  &kp N5                      &tog 1                                                                                                                              &tog 3              &kp N6              &kp N7                  &kp N8              &kp N9                  &kp N0              &none
                &kp CLCK            &kp Q           &kp W               &kp F                   &kp P                   &kp B                       &none                                                                                                                               &none               &kp J               &kp L                   &kp U               &kp Y                   &kp SEMI            &none
                &Vim_Terminal_ESC   &kp A           &kp R               &kp S                   &lt 4 T                 &lt 3 G                     &none                               &kp DELETE  &Tmux_Host          &Tmux_Guest         &kp ENTER                                   &none               &lt 3 M             &lt 4 N                 &kp E               &kp I                   &kp O               &Terminal_Vim_Mode
                &kp LSHFT           &kp X           &kp C               &kp D                   &kp V                   &kp Z                                                                       &Tmux_Host_Copy     &Tmux_Guest_Copy                                                                    &kp K               &kp H                   &kp COMMA           &kp DOT                 &kp FSLH            &kp RSHFT
                &mo 2               &kp LCTRL       &kp LALT            &kp LEFT                &kp RIGHT                                                                   &kp BSPC    &kp ESC     &kp LGUI            &kp LGUI            &kp TAB         &kp SPACE                                                           &kp UP                  &kp DOWN            &kp LALT                &kp RCTRL           &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
                &none               &kp N1          &kp N2              &kp N3                  &kp N4                  &kp N5                      &trans                                                                                                                              &tog 3              &kp N6              &kp KP_NUM              &kp KP_EQUAL        &kp KP_DIVIDE           &kp KP_MULTIPLY     &none
                &kp CLCK            &none           &none               &none                   &none                   &none                       &none                                                                                                                               &none               &none               &kp KP_N7               &kp KP_N8           &kp KP_N9               &kp KP_MINUS        &none
                &Vim_Terminal_ESC   &none           &none               &none                   &none                   &none                       &none                               &kp DELETE  &Tmux_Host          &Tmux_Guest         &kp ENTER                                   &none               &none               &kp KP_N4               &kp KP_N5           &kp KP_N6               &kp KP_PLUS         &Terminal_Vim_Mode
                &kp LSHFT           &none           &none               &none                   &none                   &none                                                                       &Tmux_Host_Copy     &Tmux_Guest_Copy                                                                    &none               &kp KP_N1               &kp KP_N2           &kp KP_N3               &kp KP_ENTER        &kp RSHFT
                &mo 2               &kp LCTRL       &kp LALT            &kp LEFT                &kp RIGHT                                                                   &kp BSPC    &kp ESC     &kp LGUI            &kp LGUI            &kp TAB         &kp KP_N0                                                           &kp UP                  &kp DOWN            &kp LALT                &kp RCTRL           &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
                &kp F1              &kp F2          &kp F3              &kp F4                  &kp F5                  &kp F6                      &tog 1                                                                                                                              &tog 3              &kp F7              &kp F8                  &kp F9              &kp F10                 &kp F11             &kp F12
                &trans              &trans          &trans              &Toggle_Mic             &kp PRINTSCREEN         &trans                      &none                                                                                                                               &none               &trans              &kp KP_NUMLOCK          &kp SCROLLLOCK      &trans                  &trans              &trans
                &trans              &kp C_MUTE      &kp C_VOL_UP        &kp C_VOL_DN            &kp C_BRIGHTNESS_INC    &kp C_BRIGHTNESS_DEC        &none                               &trans      &trans              &trans              &trans                                      &none               &kp C_PLAY_PAUSE    &kp C_PREV              &kp C_NEXT          &kp C_REWIND            &kp C_FAST_FORWARD  &trans
                &trans              &trans          &Terminal_Copy      &trans                  &Terminal_Paste         &trans                                                                      &trans              &trans                                                                              &trans              &trans                  &trans              &trans                  &trans              &trans
                &trans              &trans          &trans              &kp HOME                &kp END                                                                     &trans      &trans      &trans              &trans              &trans          &trans                                                              &kp PAGE_UP             &kp PAGE_DOWN       &trans                  &trans              &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
                &none               &bt BT_SEL 0    &bt BT_SEL 1        &bt BT_SEL 2            &bt BT_SEL 3            &bt BT_SEL 4                &tog 1                                                                                                                              &trans              &none               &none                   &none               &none                   &none               &none
                &none               &none           &none               &none                   &none                   &none                       &bootloader                                                                                                                         &bootloader         &none               &mmv_up_left            &mmv_up             &mmv_up_right           &none               &none
                &studio_unlock      &mkp LCLK       &mkp MCLK           &mkp RCLK               &mkp MB4                &mkp MB5                    &none                               &none       &none               &none               &none                                       &stp STP_BAT        &bl BL_INC          &mmv_left               &none               &mmv_right              &none               &none
                &trans              &none           &none               &none                   &macro_ver              &none                                                                       &none               &none                                                                               &bl BL_DEC          &mmv_down_left          &mmv_down           &mmv_down_right         &none               &trans
                &none               &trans          &trans              &msc SCRL_LEFT          &msc SCRL_RIGHT                                                             &trans      &trans      &trans              &trans              &bl BL_TOG      &rgb_ug RGB_TOG                                                     &msc SCRL_UP            &msc SCRL_DOWN      &trans                  &trans              &none
            >;
        };

        symbols {
            display-name = "Symbols";
            bindings = <
                &none               &none           &none               &none                   &none                   &none                       &tog 1                                                                                                                              &tog 3              &none               &none                   &none               &none                   &none               &none
                &none               &none           &none               &none                   &none                   &none                       &none                                                                                                                               &none               &none               &none                   &none               &none                   &none               &none
                &none               &none           &kp LEFT_BRACE      &kp LBKT                &kp LEFT_PARENTHESIS    &kp GRAVE                   &none                               &none       &none               &none               &none                                       &none               &kp BACKSLASH       &kp EQUAL               &kp MINUS           &kp SQT                 &Arrow              &none
                &trans              &none           &kp RIGHT_BRACE     &kp RBKT                &kp RIGHT_PARENTHESIS   &kp TILDE                                                                   &none               &none                                                                               &kp PIPE            &kp PLUS                &kp UNDERSCORE      &kp DOUBLE_QUOTES       &Scope_Resolution   &trans
                &none               &trans          &trans              &trans                  &trans                                                                      &trans      &trans      &trans              &trans              &trans          &trans                                                              &trans                  &trans              &trans                  &trans              &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
